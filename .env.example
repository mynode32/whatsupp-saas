# ─────────────────────────────────────────────────────────────────────────────
#  mynode — .env.example. Copy to .env.local and fill in.
#
#  The guided setup ("/setup" in Claude Code) does this for you. The marketing
#  demo needs no keys; real accounts/dashboard/chatbot data require Supabase.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Anthropic (Claude) — drafts knowledge-grounded replies in your brand voice
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── WhatsApp via Twilio — connects your WhatsApp Business number ─────────────
# https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# â”€â”€ Instagram via Meta â€” one platform app; customers connect via OAuth â”€â”€
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ── Supabase — stores conversations, knowledge & automations (optional) ──────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Webhook signing — signs/verifies inbound provider webhooks ───────────────
WEBHOOK_SIGNING_SECRET=

# ── Demo mode — skips real login. NEVER honored in production regardless
#    of this value; only useful in dev before Supabase is configured. ───────
DEMO_MODE=false
